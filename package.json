{
  "name": "discord-rep",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run lint && next build",
    "db:push": "doppler run -- drizzle-kit push",
    "db:studio": "doppler run -- drizzle-kit studio",
    "dev": "next dev",
    "lint": "eslint .",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "next typegen && tsc --noEmit",
    "dev:secrets": "doppler run -- next dev",
    "build:secrets": "doppler run -- npm run build",
    "start:secrets": "doppler run -- next start",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "doppler run -- drizzle-kit migrate",
    "test:coverage": "vitest run --coverage",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "vite preview",
    "deploy:vinext": "vinext-cloudflare deploy",
    "test:e2e": "node --env-file-if-exists=.env.local scripts/run-e2e.mjs",
    "test:integration": "vitest run __tests__/chat.integration.test.ts",
    "chat:cleanup": "doppler run -- node scripts/cleanup-chat.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "@aws-sdk/s3-request-presigner": "^3.1164.0",
    "@clerk/nextjs": "^7.9.25",
    "@neondatabase/serverless": "^1.2.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-query": "^5.107.1",
    "@trpc/client": "^11.25.0",
    "@trpc/next": "^11.25.0",
    "@trpc/react-query": "^11.25.0",
    "@trpc/server": "^11.25.0",
    "@vinext/cloudflare": "^1.3.3",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "superjson": "^2.2.6",
    "vinext": "^1.4.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@clerk/backend": "^3.27.0",
    "@clerk/testing": "^2.2.55",
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.12",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "cf": "^1.0.0-beta.28",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.5",
    "jsdom": "^31.0.0",
    "pg": "^8.23.1",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "standardwebhooks": "^1.1.1",
    "tailwindcss": "^4.3.5",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  },
  "ct3aMetadata": {
    "initVersion": "7.25.2"
  },
  "packageManager": "npm@12.2.2",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "overrides": {
    "eslint-plugin-import": {
      "eslint": "$eslint"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "eslint-plugin-react": {
      "eslint": "$eslint"
    },
    "minimatch@>=7 <11.0.1": "^11.0.5",
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.28.2"
    },
    "satori": {
      "fflate": "0.7.5"
    }
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261104.1": true
  }
}
